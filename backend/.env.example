PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database connection URLs (Supabase / PostgreSQL)
# Direct connection (port 5432) or Session/Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Secrets
JWT_ACCESS_SECRET=velozity_access_super_secret_jwt_key_2026_change_me
JWT_REFRESH_SECRET=velozity_refresh_super_secret_jwt_key_2026_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
