# Absolute origin of the deployed backend. Leave EMPTY for local development:
# the Vite dev server proxies /api and /socket.io to the backend for you.
# Example for production: VITE_API_URL=https://velozity-api.onrender.com
VITE_API_URL=

# Local development only. Override if the backend is not on port 5000
# (macOS AirPlay Receiver squats on 5000). Not used in production builds.
# BACKEND_URL=http://localhost:5055
