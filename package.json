{
  "name": "velozity-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Client Project Dashboard with Role-Based Access & Live Activity Feed",
  "scripts": {
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install && npm run db:generate",
    "dev": "concurrently --names \"api,web\" --prefix-colors \"cyan,magenta\" --kill-others \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:push": "npm --prefix backend run prisma:push",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:studio": "npm --prefix backend run prisma:studio",
    "seed": "npm --prefix backend run seed",
    "verify": "npm --prefix backend run verify"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
