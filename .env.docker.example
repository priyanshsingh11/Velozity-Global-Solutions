# Copy to `.env` in the repository root before running `docker compose up`.
# docker compose reads this file automatically.

POSTGRES_USER=velozity
POSTGRES_PASSWORD=velozity_dev_password
POSTGRES_DB=velozity

FRONTEND_URL=http://localhost:5173

# Generate your own, e.g.  openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
